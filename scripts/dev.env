# Local, no-Docker profile. `make dev` loads this. Nothing secret lives here.
LLM_PROVIDER=stub
STUB_BASE_URL=http://127.0.0.1:9009
EMBEDDING_BACKEND=hash
VECTOR_BACKEND=local
INDEX_DIR=./data/index
CORPUS_MANIFEST=./corpus/sources.yaml
PROMPT_DIR=./prompts
REDIS_URL=memory://local
EXECUTION_MODE=inline
TRACING_ENABLED=false
LOG_FORMAT=console
LOG_LEVEL=INFO
