# =============================================================================
#  claim-triage  --  environment template            (D4: nothing secret in git)
#  cp .env.example .env   and fill in the blanks before `docker compose up`.
#  Every value below is injected at runtime. No credential, endpoint or model
#  identifier is hard-coded anywhere in the source tree.
# =============================================================================

# ---------------------------------------------------------------- model provider
# openai_compat : any OpenAI-compatible /chat/completions endpoint
#                 (Groq, OpenRouter, Together, vLLM, LM Studio, Ollama's
#                  /v1 shim ...). This is the default.
# gemini        : Google Generative Language API
# stub          : the in-repo llm-stub service. No key, no network, fixed
#                 latency. Used by the load test (D6) and by CI.
LLM_PROVIDER=openai_compat

# Base URL *without* a trailing slash. Examples:
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://host.docker.internal:11434/v1
LLM_BASE_URL=
LLM_API_KEY=
# e.g. llama-3.3-70b-versatile  /  gemini-2.0-flash  /  qwen2.5:7b
LLM_MODEL=
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=1200

# Cost accounting (L5). USD per 1M tokens, as published by your provider.
# Leave at 0 for a free tier and the run still reports token counts.
LLM_PRICE_PROMPT_PER_MTOK=0.0
LLM_PRICE_COMPLETION_PER_MTOK=0.0

# ---------------------------------------------------------------- resilience (A5)
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_BASE_SECONDS=0.5
LLM_BACKOFF_MAX_SECONDS=8
CIRCUIT_FAIL_THRESHOLD=5
CIRCUIT_RESET_SECONDS=30
TOOL_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------- agent loop (A1)
AGENT_MAX_STEPS=14
AGENT_MAX_TOOL_CALLS=12
AGENT_WALL_CLOCK_SECONDS=120
RETRIEVAL_TOP_K=6
VERIFIER_MIN_SUPPORT=0.60
ESCALATION_MIN_RETRIEVAL_SCORE=0.25

# ---------------------------------------------------------------- retrieval (L1)
# sentence_transformers : all-MiniLM-L6-v2, runs locally, no cost
# hash                  : deterministic offline fallback, no model download
EMBEDDING_BACKEND=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
CHUNK_TOKENS=320
CHUNK_OVERLAP_TOKENS=64

# chroma_http | local  (local = numpy store on disk, used for `make dev`)
VECTOR_BACKEND=chroma_http
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION=policy_clauses
INDEX_DIR=/data/index

# ---------------------------------------------------------------- infrastructure
REDIS_URL=redis://redis:6379/0
QUEUE_NAME=triage:queue
# inline = execute in-process (dev only, no worker container)
EXECUTION_MODE=queue
WORKER_CONCURRENCY=2
RUN_TTL_SECONDS=86400

# ---------------------------------------------------------------- caching (D7)
CACHE_EMBEDDINGS=true
CACHE_RETRIEVALS=true
CACHE_RUNS=true
CACHE_TTL_SECONDS=3600

# ---------------------------------------------------------------- rate limit (D7)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ---------------------------------------------------------------- guardrails (L4)
GUARDRAILS_ENABLED=true
TOXICITY_THRESHOLD=0.60
INJECTION_THRESHOLD=0.50

# ---------------------------------------------------------------- prompts (L2)
PROMPT_SET=v2
PROMPT_DIR=/app/prompts

# ---------------------------------------------------------------- observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAME=claim-triage
TRACING_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=json

# ---------------------------------------------------------------- SLO (D6)
SLO_P95_SECONDS=45
